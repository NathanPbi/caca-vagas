# Copie para .env e preencha. Tudo é opcional: sem chaves, só a Gupy é usada.
PORT=8085

# Sites de empresas, páginas "Trabalhe conosco" e sistemas como Sólides, InHire, Kenoby (via Google)
# Serper: 2.500 consultas grátis no cadastro, depois pago por uso. https://serper.dev
SERPER_KEY=

# Google Vagas (via SerpApi): 250 buscas grátis por mês. https://serpapi.com
SERPAPI_KEY=

# Adzuna (grátis): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble (grátis): https://br.jooble.org/api/about
JOOBLE_KEY=
JOOBLE_HOST=br.jooble.org

# Análise de currículo com IA (opcional). Sem chave, a análise usa regras automáticas.
# Chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

CACHE_MIN=20
